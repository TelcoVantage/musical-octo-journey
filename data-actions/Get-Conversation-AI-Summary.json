{
  "name": "Get Conversation AI Summary",
  "integrationType": "purecloud-data-actions",
  "actionType": "custom",
  "config": {
    "request": {
      "requestUrlTemplate": "/api/v2/conversations/${input.conversationId}/summaries",
      "requestType": "GET",
      "headers": {},
      "requestTemplate": "${input.rawRequest}"
    },
    "response": {
      "translationMap": {
        "sessionText": "$.sessionSummaries[*].text",
        "conversationText": "$.summary.text",
        "sessionEdited": "$.sessionSummaries[*].editedSummary.text",
        "conversationEdited": "$.summary.editedSummary.text",
        "sessionReason": "$.sessionSummaries[*].reason.text",
        "conversationReason": "$.summary.reason.text",
        "sessionResolution": "$.sessionSummaries[*].resolution.text",
        "conversationResolution": "$.summary.resolution.text",
        "sessionFollowup": "$.sessionSummaries[*].followup.text",
        "conversationFollowup": "$.summary.followup.text",
        "sessionStatus": "$.sessionSummaries[*].status",
        "conversationStatus": "$.summary.status"
      },
      "translationMapDefaults": {
        "sessionText": "[]",
        "conversationText": "\"\"",
        "sessionEdited": "[]",
        "conversationEdited": "\"\"",
        "sessionReason": "[]",
        "conversationReason": "\"\"",
        "sessionResolution": "[]",
        "conversationResolution": "\"\"",
        "sessionFollowup": "[]",
        "conversationFollowup": "\"\"",
        "sessionStatus": "[]",
        "conversationStatus": "\"\""
      },
      "successTemplate": "{\"summary\": ${successTemplateUtils.firstFromArray(\"${sessionText}\", \"${conversationText}\")}, \"editedSummary\": ${successTemplateUtils.firstFromArray(\"${sessionEdited}\", \"${conversationEdited}\")}, \"reason\": ${successTemplateUtils.firstFromArray(\"${sessionReason}\", \"${conversationReason}\")}, \"resolution\": ${successTemplateUtils.firstFromArray(\"${sessionResolution}\", \"${conversationResolution}\")}, \"followup\": ${successTemplateUtils.firstFromArray(\"${sessionFollowup}\", \"${conversationFollowup}\")}, \"status\": ${successTemplateUtils.firstFromArray(\"${sessionStatus}\", \"${conversationStatus}\")}}"
    }
  },
  "contract": {
    "input": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "Get Conversation AI Summary request",
        "type": "object",
        "required": [
          "conversationId"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "Genesys Cloud conversation ID"
          }
        },
        "additionalProperties": true
      }
    },
    "output": {
      "successSchema": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "Get Conversation AI Summary response",
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "AI generated summary text"
          },
          "editedSummary": {
            "type": "string",
            "description": "Summary text as edited by the agent (empty when not edited)"
          },
          "reason": {
            "type": "string",
            "description": "Contact reason"
          },
          "resolution": {
            "type": "string",
            "description": "Resolution"
          },
          "followup": {
            "type": "string",
            "description": "Follow-up actions"
          },
          "status": {
            "type": "string",
            "description": "Summary generation status"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "secure": false
}
